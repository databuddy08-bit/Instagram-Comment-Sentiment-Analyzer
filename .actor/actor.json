{
    "actorSpecification": 1,
    "name": "instagram-comment-sentiment-analyzer",
    "title": "Instagram Comment Sentiment Analyzer",
    "description": "Scrapes comments from Instagram posts and performs AI-powered sentiment analysis. Returns structured data with sentiment scores, labels (positive/negative/neutral), emotion detection, and engagement metrics.",
    "version": "1.0.0",
    "buildTag": "latest",
    "input": "./input_schema.json",
    "dockerfile": "../Dockerfile",
    "readme": "../README.md",
    "storages": {
        "dataset": {
            "actorSpecification": 1,
            "views": {
                "overview": {
                    "title": "Analyzed Comments",
                    "description": "Instagram comments with sentiment analysis results",
                    "transformation": {
                        "fields": ["postShortcode","commentAuthor","commentText","sentimentLabel","sentimentScore","emotionTags","commentLikes","commentTimestamp"]
                    },
                    "display": {
                        "component": "table",
                        "properties": {
                            "postShortcode": { "label": "Post", "format": "text" },
                            "commentAuthor": { "label": "Author", "format": "text" },
                            "commentText": { "label": "Comment", "format": "text" },
                            "sentimentLabel": { "label": "Sentiment", "format": "text" },
                            "sentimentScore": { "label": "Score", "format": "number" },
                            "emotionTags": { "label": "Emotions", "format": "array" },
                            "commentLikes": { "label": "Likes", "format": "number" },
                            "commentTimestamp": { "label": "Time", "format": "text" }
                        }
                    }
                }
            }
        }
    },
    "output": "./OUTPUT_SCHEMA.json"
}
